{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": 2
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "api_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "file",
                  "start_line",
                  "end_line"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "description",
            "evidence"
          ],
          "additionalProperties": false
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "file",
                    "start_line",
                    "end_line"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "description",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "file",
                    "start_line",
                    "end_line"
                  ],
                  "additionalProperties": false
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "operation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "fields",
              "rule",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "api_id",
        "checks",
        "scope",
        "unresolved"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "operation"
          ],
          "not": {
            "required": [
              "operations"
            ]
          }
        },
        {
          "required": [
            "operations"
          ],
          "not": {
            "required": [
              "operation"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "source_revision",
    "run_id",
    "stage",
    "status",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
