{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": 3
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "api_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "explicit",
                  "inferred"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start_line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end_line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "file",
                    "start_line",
                    "end_line"
                  ],
                  "additionalProperties": false
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "trace": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "string",
                          "minLength": 1
                        },
                        "to": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "file": {
                                "type": "string",
                                "minLength": 1
                              },
                              "start_line": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "end_line": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "required": [
                              "file",
                              "start_line",
                              "end_line"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "from",
                        "to",
                        "evidence"
                      ],
                      "additionalProperties": false
                    }
                  }
                ]
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "operation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "fields",
              "rule",
              "basis",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "api_id",
        "requirements",
        "unresolved"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "source_revision",
    "run_id",
    "stage",
    "status",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
